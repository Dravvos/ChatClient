<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800"
        Loaded="Window_Loaded">

    <Grid TextElement.FontFamily="Segoe UI, Arial" Background="#FFE9EDEF">
        <Border Padding="0" CornerRadius="10" Margin="10" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Coluna da Esquerda (Lista de Chats) -->
                    <ColumnDefinition Width="300" />
                    <!-- Coluna da Direita (Conversa Ativa) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- BARRA LATERAL -->
                <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#FFD5D8DC" Background="#1A1A19">
                    <StackPanel>
                        <!-- Meu Perfil -->
                        <Border Padding="15" BorderThickness="0,0,0,1" BorderBrush="#FFDDDDDD" Height="70">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border CornerRadius="23" Background="#FF5C6BC0" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Text="D" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="txtCurrentUsername" Foreground="White" FontWeight="Bold" Text="Daniel" />
                                    <TextBlock Text="Online" Foreground="#0ca30c" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Barra de Pesquisa -->
                        <Border Padding="12" BorderThickness="0,0,0,0" BorderBrush="#FFDDDDDD">
                            <TextBox Text="Search Conversations" Name="txtSearchUser" KeyUp="txtSearchUser_KeyUp" Background="Transparent" Padding="10,5" Height="35" VerticalContentAlignment="Center" Foreground="White" BorderBrush="White">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                        <Setter Property="Opacity" Value="0.3"/>
                                    </Style>

                                </TextBox.Resources>

                            </TextBox>
                        </Border>

                        <!-- Lista de Conversas -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox Name="ContactsListBox"
             BorderThickness="0"
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="ContactsListBox_SelectionChanged">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="12,0,12,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" CornerRadius="8" Padding="14" Background="Transparent">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF032042"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#141413"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="23" Background="#FF5C6BC0" Width="36" Height="36" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding AvatarLetter}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#6da7ec"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding LastMessagePreview}" Foreground="#c3c2b7" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding LastMessageTimeDisplay}" Foreground="#898781" FontSize="12" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ÁREA DO CHAT (DIREITA) -->
                <Grid Name="chatArea" Visibility="Hidden" Grid.Column="1" Background="#FFEFEAE2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho do Chat -->
                    <Border Grid.Row="0" Padding="15" BorderThickness="0,0,0,1" BorderBrush="#FFDDDDDD" Background="#151515">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="23" Background="#FF5C6BC0" Width="46" Height="46" Margin="0,0,12,0">
                                <TextBlock Text="A" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Name="txtUsername" Text="Ana" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Name="txtUserId" Text="" Visibility="Collapsed" FontSize="12"/>
                                <TextBlock Name="txtuserStatus" Text="Online" Foreground="DarkGray" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Mensagens -->
                    <ListBox Grid.Row="1"
         Name="MessagesListBox"
         Padding="25"
         Background="#151515"
         BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,4">
                                    <Border x:Name="Bubble" CornerRadius="10" Padding="12" MaxWidth="420" BorderThickness="1">
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Foreground="#f0efec"/>
                                    </Border>
                                    <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Margin="5,5,5,0">
                                        <TextBlock Text="{Binding TimeDisplay}" FontWeight="Bold" Foreground="#FF777777" FontSize="11"/>
                                        <TextBlock x:Name="StatusText" Text="{Binding StatusIndicator}" Foreground="#6da7ec" FontSize="11" Margin="5,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                        <Setter TargetName="Bubble" Property="Background" Value="#2A78D6"/>
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#2A78D6"/>
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="MetaPanel" Property="HorizontalAlignment" Value="Right"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOwnMessage}" Value="False">
                                        <Setter TargetName="Bubble" Property="Background" Value="#1a1a19"/>
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="MetaPanel" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="StatusText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Bubble" Property="BorderBrush">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#FFDDDDDD" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Campo de Envio (Rodapé) -->
                    <Border Grid.Row="2" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#FFDDDDDD" Background="#151515">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Name="btnAttach" Click="btnAttach_Click" Grid.Column="0" Content="📎" FontSize="18" Background="Transparent" BorderBrush="Transparent" Margin="0,0,10,0" Foreground="White"/>
                            <TextBox Text="Type a message" Name="txtMessage" KeyUp="txtMessage_KeyUp" Grid.Column="1" Background="#1a1a19" Padding="10,0" Height="40" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Foreground="White"/>
                            <Button Name="BtnSend" Click="BtnSend_Click" Grid.Column="2" Content="➤" Foreground="White" FontSize="18" Background="#2a78d6" Width="42" Height="40" Margin="10,0,0,0" VerticalAlignment="Top" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>